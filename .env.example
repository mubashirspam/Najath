# Najath — local environment.
#
#   cp .env.example .env
#
# This configures YOUR LAPTOP. Nothing else reads it: staging and production
# values live in Vercel environment variables and GitHub environment secrets.
# That is why there is one DATABASE_URL here and not one per environment.
#
# Full map of which value lives where: docs/engineering/06-environments.md

# ─── Database ────────────────────────────────────────────────────────────────
# Two databases (dev+staging share one, production has its own) and two kinds of
# connection. Neon gives you both hostnames for the same database:
#
#   pooled    ep-xxx-pooler.region.aws.neon.tech    ← the app
#   direct    ep-xxx.region.aws.neon.tech           ← drizzle-kit
#
# The app runs on serverless functions, so it needs the pooler or it exhausts
# Postgres connections. drizzle-kit needs the direct one: PgBouncer in
# transaction mode drops the session state it relies on (protocol-level prepared
# statements, and the advisory lock that stops two migrations racing).

# POOLED. Shared dev + staging. Used by the app at runtime.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# DIRECT, same database. Used by db:generate / db:migrate / db:studio.
# Optional — falls back to DATABASE_URL if unset, which is fine locally and
# wrong on a shared branch.
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# DIRECT, production. Read-only: `pnpm --filter @najath/db db:studio:prod`.
# There is deliberately no db:migrate:prod — CI owns every migration (ADR-0001),
# and one applied from here never reaches the journal check guarding the PR.
DATABASE_URL_PROD=""

# ─── Auth ────────────────────────────────────────────────────────────────────
# openssl rand -base64 32   — a different secret per environment, or a staging
# session token would be valid in production.
BETTER_AUTH_SECRET=""

# Where the browser actually loads the API from.
BETTER_AUTH_URL="http://localhost:3000"

# ─── Background jobs ─────────────────────────────────────────────────────────
# Read by the Trigger.dev CLI, not by our code.
TRIGGER_SECRET_KEY=""
TRIGGER_PROJECT_REF=""

# ─── Not wired yet ───────────────────────────────────────────────────────────
# Uncomment when the module that needs it lands. Left commented rather than
# blank so an empty value never looks like a misconfiguration.

# M01 — guardian OTP. A real key sends real SMS to a real guardian's phone;
# use the test key locally.
# MSG91_AUTH_KEY=""
# MSG91_SENDER_ID=""
# MSG91_OTP_TEMPLATE_ID=""

# M02 — student photos, documents, report card PDFs.
# Point dev and staging at najath-media-staging. Writing to the production
# bucket from staging overwrites real files, and there is no undo.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="najath-media-staging"
# R2_PUBLIC_BASE_URL=""

# M12 — push and circulars. The whole service-account JSON on one line.
# FCM_SERVICE_ACCOUNT_JSON=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""

# P0-OPS-02 — observability.
# SENTRY_DSN=""
# AXIOM_TOKEN=""
# AXIOM_DATASET="najath-dev"
