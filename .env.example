# Najath — local environment.
#
#   cp .env.example .env
#
# This configures YOUR LAPTOP. Nothing else reads it: staging and production
# values live in Vercel environment variables and GitHub environment secrets.
# That is why there is one DATABASE_URL here and not one per environment.
#
# Full map of which value lives where: docs/engineering/06-environments.md

# ─── Database ────────────────────────────────────────────────────────────────
# The Neon branch your laptop talks to. Use the shared `dev` branch for normal
# work, or your own branch when you are changing schema.
#
# Use the DIRECT endpoint, not the `-pooler` one: drizzle-kit runs migrations in
# a transaction and PgBouncer in transaction mode will reject that.
DATABASE_URL="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ─── Auth ────────────────────────────────────────────────────────────────────
# openssl rand -base64 32   — a different secret per environment, or a staging
# session token would be valid in production.
BETTER_AUTH_SECRET=""

# Where the browser actually loads the API from.
BETTER_AUTH_URL="http://localhost:3000"

# ─── Background jobs ─────────────────────────────────────────────────────────
# Read by the Trigger.dev CLI, not by our code.
TRIGGER_SECRET_KEY=""
TRIGGER_PROJECT_REF=""

# ─── Not wired yet ───────────────────────────────────────────────────────────
# Uncomment when the module that needs it lands. Left commented rather than
# blank so an empty value never looks like a misconfiguration.

# M01 — guardian OTP. A real key sends real SMS to a real guardian's phone;
# use the test key locally.
# MSG91_AUTH_KEY=""
# MSG91_SENDER_ID=""
# MSG91_OTP_TEMPLATE_ID=""

# M02 — student photos, documents, report card PDFs.
# Point dev and staging at najath-media-staging. Writing to the production
# bucket from staging overwrites real files, and there is no undo.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="najath-media-staging"
# R2_PUBLIC_BASE_URL=""

# M12 — push and circulars. The whole service-account JSON on one line.
# FCM_SERVICE_ACCOUNT_JSON=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""

# P0-OPS-02 — observability.
# SENTRY_DSN=""
# AXIOM_TOKEN=""
# AXIOM_DATASET="najath-dev"
