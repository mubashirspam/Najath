# Najath — local environment template.
#
#   cp .env.example .env
#
# This file is the canonical list of every variable the platform reads. `.env`
# is gitignored and holds your real values.
#
# IMPORTANT: this file configures your *laptop*. Deployed environments do not
# read it — staging and production values live in Vercel environment variables
# and GitHub environment secrets. See docs/engineering/06-environments.md for
# which variable lives where, and why.

# ─────────────────────────────────────────────────────────────────────────────
# Target
# ─────────────────────────────────────────────────────────────────────────────

# Which environment your local tooling talks to: dev | staging | prod.
# Used by scripts that pick a DATABASE_URL_* below. Leave on dev for normal work.
NAJATH_ENV="dev"

# ─────────────────────────────────────────────────────────────────────────────
# Database — Neon
# ─────────────────────────────────────────────────────────────────────────────
# Two databases, three environments: dev and staging deliberately share one Neon
# branch; production has its own. The branch → environment mapping lives in
# .github/workflows/db.yml and is documented in docs/adr/0001-migrations-run-in-ci.md.

# What the app and drizzle-kit use by default. Point this at the Neon `dev`
# branch — or at a personal Neon branch, which is better if you are changing
# schema.
DATABASE_URL="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/najath_erp?sslmode=require"

# Neon branch `dev` — the shared dev + staging database.
DATABASE_URL_DEV="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/najath_erp?sslmode=require"

# Optional. Staging currently shares DATABASE_URL_DEV, so leave this empty.
# Fill it only if staging is later split onto its own Neon branch — the CI
# mapping in db.yml has to change at the same time.
DATABASE_URL_STAGING=""

# Neon branch `production`. READ-ONLY USE FROM A LAPTOP.
# Inspection with `drizzle-kit studio` is fine. Applying migrations from your
# machine is not — CI owns every `db:migrate`. See ADR-0001.
DATABASE_URL_PROD=""

# ─────────────────────────────────────────────────────────────────────────────
# Auth — Better Auth
# ─────────────────────────────────────────────────────────────────────────────

# openssl rand -base64 32     (a different secret per environment)
BETTER_AUTH_SECRET=""

# Origin the API is served from. Must match where the browser actually loads it.
#   local    http://localhost:3000
#   staging  https://stg.najath.app
#   prod     https://najath.app
BETTER_AUTH_URL="http://localhost:3000"

# Mobile bearer tokens. Access 15 min, refresh 60 days, rotating.
AUTH_ACCESS_TOKEN_TTL="900"
AUTH_REFRESH_TOKEN_TTL="5184000"

# ─────────────────────────────────────────────────────────────────────────────
# Storage — Cloudflare R2
# ─────────────────────────────────────────────────────────────────────────────
# One bucket per environment. Never point staging at the production bucket —
# a bad seed there overwrites real student photos and report cards.
#   dev/staging  najath-media-staging
#   prod         najath-media

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="najath-media-staging"
R2_PUBLIC_BASE_URL=""

# ─────────────────────────────────────────────────────────────────────────────
# Background jobs — Trigger.dev
# ─────────────────────────────────────────────────────────────────────────────

TRIGGER_SECRET_KEY=""
TRIGGER_PROJECT_REF=""

# ─────────────────────────────────────────────────────────────────────────────
# Messaging
# ─────────────────────────────────────────────────────────────────────────────

# FCM push. The whole service-account JSON, single-quoted on one line.
FCM_SERVICE_ACCOUNT_JSON=""

# MSG91 — guardian OTP. Use a test key locally; a real one sends real SMS to
# real phone numbers, which in this product means a guardian's actual phone.
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_OTP_TEMPLATE_ID=""

# WhatsApp Cloud API — optional, high-priority circulars only (M12).
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# ─────────────────────────────────────────────────────────────────────────────
# Observability
# ─────────────────────────────────────────────────────────────────────────────

SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
AXIOM_TOKEN=""
AXIOM_DATASET="najath-dev"

# ─────────────────────────────────────────────────────────────────────────────
# Institution defaults
# ─────────────────────────────────────────────────────────────────────────────
# Seed values only. Once an institution row exists these are read from the
# database (M13), not from here.

DEFAULT_INSTITUTION_TIMEZONE="Asia/Kolkata"
DEFAULT_INSTITUTION_LOCALE="en"
